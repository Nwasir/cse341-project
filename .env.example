# Copy this file to .env and fill in your values. .env is ignored by git.
# On Render, add the same keys under Environment (config vars) instead.

# Needed for the /contacts routes. Run "npm run seed" once to load the starter data.
# If it is not set, /professional falls back to data/professional.js and /contacts returns 503.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Optional. Database name to use (defaults to cse341).
MONGODB_DB_NAME=cse341

# Optional. Defaults to 8080, which is the port the frontend calls.
PORT=8080
